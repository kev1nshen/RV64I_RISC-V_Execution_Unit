-- ============================================================================
-- SLL: Shift Left Logical (FuncClass=00, ShiftFN=01, AddnSub=0)
-- ============================================================================
-- Shift 1 left by 1 bit (A=1, B=1 -> A=B, so Zero=1)
0000000000000001 0000000000000001 00 00 01 0 0 0000000000000002 1 0 0
-- Shift 1 left by 31 bits (A=1, B=31 -> A < B, so AltB=1, AltBu=1)
0000000000000001 000000000000001F 00 00 01 0 0 0000000080000000 0 1 1
-- Shift 1 left by 63 bits (A=1, B=63 -> A < B, so AltB=1, AltBu=1)
0000000000000001 000000000000003F 00 00 01 0 0 8000000000000000 0 1 1
-- Shift FFFF left by 48 bits (A=65535, B=48 -> A > B, so all flags 0)
000000000000FFFF 0000000000000030 00 00 01 0 0 FFFF000000000000 0 0 0
-- Shift out all bits (A=2, B=63 -> A < B, so AltB=1, AltBu=1)
0000000000000002 000000000000003F 00 00 01 0 0 0000000000000000 0 1 1
-- Alternating bits (A is negative, B=1 -> A < B signed (AltB), but A > B unsigned)
AAAAAAAAAAAAAAAA 0000000000000001 00 00 01 0 0 5555555555555554 0 1 0

-- ============================================================================
-- SRL: Shift Right Logical (FuncClass=00, ShiftFN=10, AddnSub=0)
-- ============================================================================
-- MSB >> 1 (A is negative, B=1 -> AltB=1)
8000000000000000 0000000000000001 00 00 10 0 0 4000000000000000 0 1 0
-- MSB >> 63 (A is negative, B=63 -> AltB=1)
8000000000000000 000000000000003F 00 00 10 0 0 0000000000000001 0 1 0
-- Full Fs >> 32 (A is negative, B=32 -> AltB=1)
FFFFFFFFFFFFFFFF 0000000000000020 00 00 10 0 0 00000000FFFFFFFF 0 1 0
-- Shift 1 by 65 (A=4, B=65 -> A < B, so AltB=1, AltBu=1)
0000000000000004 0000000000000041 00 00 10 0 0 0000000000000002 0 1 1

-- ============================================================================
-- SRA: Shift Right Arithmetic (FuncClass=00, ShiftFN=11, AddnSub=0)
-- ============================================================================
-- Positive shift (A=large pos, B=1 -> all flags 0)
4000000000000000 0000000000000001 00 00 11 0 0 2000000000000000 0 0 0
-- Negative shift (A=negative, B=1 -> AltB=1)
8000000000000000 0000000000000001 00 00 11 0 0 C000000000000000 0 1 0
-- Negative shift by 63 (A=negative, B=63 -> AltB=1)
8000000000000000 000000000000003F 00 00 11 0 0 FFFFFFFFFFFFFFFF 0 1 0
-- Alternating bits (A=negative, B=4 -> AltB=1)
AAAAAAAAAAAAAAAA 0000000000000004 00 00 11 0 0 FAAAAAAAAAAAAAAA 0 1 0

-- ============================================================================
-- 32-Bit Word Operations (ExtWord=1)
-- ============================================================================
-- SLLW (A=1, B=31 -> AltB=1, AltBu=1)
0000000000000001 000000000000001F 00 00 01 0 1 FFFFFFFF80000000 0 1 1
-- SRLW (A=4294967295, B=1 -> all flags 0)
00000000FFFFFFFF 0000000000000001 00 00 10 0 1 000000007FFFFFFF 0 0 0
-- SRAW (A=2147483648, B=1 -> all flags 0)
0000000080000000 0000000000000001 00 00 11 0 1 FFFFFFFFC0000000 0 0 0
-- SLLW (A=1, B=5 -> AltB=1, AltBu=1)
0000000000000001 0000000000000005 00 00 01 0 1 0000000000000020 0 1 1